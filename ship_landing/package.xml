<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ship_landing</name>
  <version>0.0.0</version>
  <description>Autonomous UAV precision landing on a moving vessel in GNSS-denied environments using ROS 2, Gazebo and ArduPilot.</description>
  <maintainer email="th.tsantilas@gmail.com">TeaTimeIroh</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>ardupilot_msgs</depend>
  <depend>sensor_msgs</depend>

  <exec_depend>ardupilot_gz_bringup</exec_depend>
  <exec_depend>ardupilot_gazebo</exec_depend>
  <exec_depend>ardupilot_sitl</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
