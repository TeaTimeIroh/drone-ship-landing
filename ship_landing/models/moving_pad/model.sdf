<?xml version="1.0"?>
<sdf version="1.9">
  <!-- The landing pad of aruco_pad, on a cart that can move in the horizontal plane.

       The pad hangs from the world on two sliding joints, one east-west and one
       north-south, and each joint is driven at a commanded speed. The joints, not
       friction with the ground, decide where the pad is, so it cannot tip, sink or be
       pushed aside by the drone landing on it.

       Speed commands (gz.msgs.Double, m/s):
         /model/moving_pad/joint/slide_east/cmd_vel
         /model/moving_pad/joint/slide_north/cmd_vel
       True joint positions (gz.msgs.Model):
         /world/<world>/model/moving_pad/joint_state

       The pad is 0.10 m thick with its underside 0.02 m above the ground, so its top
       is at z = 0.12 m. The texture is a copy of the one in aruco_pad. -->
  <model name="moving_pad">

    <link name="carriage">
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
    </link>

    <link name="pad">
      <pose>0 0 0.07 0 0 0</pose>
      <inertial>
        <mass>20.0</mass>
        <inertia>
          <ixx>2.62</ixx><iyy>2.62</iyy><izz>5.21</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <box>
            <size>1.25 1.25 0.10</size>
          </box>
        </geometry>
      </collision>
      <!-- Body of the pad, plain white. -->
      <visual name="base">
        <geometry>
          <box>
            <size>1.25 1.25 0.10</size>
          </box>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>
        </material>
      </visual>
      <!-- Marker face, a textured plane just above the top of the box. -->
      <visual name="marker">
        <pose>0 0 0.051 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>1.25 1.25</size>
          </plane>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>
          <pbr>
            <metal>
              <albedo_map>materials/textures/aruco_pad.png</albedo_map>
              <metalness>0.0</metalness>
              <roughness>1.0</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>

    <!-- The effort limits are needed: without them Gazebo's physics engine does not
         enforce the position limits on a joint driven by speed commands. -->
    <joint name="slide_east" type="prismatic">
      <parent>world</parent>
      <child>carriage</child>
      <axis>
        <xyz expressed_in="__model__">1 0 0</xyz>
        <limit>
          <lower>-3.5</lower>
          <upper>3.5</upper>
          <effort>2000</effort>
        </limit>
      </axis>
    </joint>

    <joint name="slide_north" type="prismatic">
      <parent>carriage</parent>
      <child>pad</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit>
          <lower>-3.5</lower>
          <upper>3.5</upper>
          <effort>2000</effort>
        </limit>
      </axis>
    </joint>

    <plugin filename="gz-sim-joint-controller-system"
      name="gz::sim::systems::JointController">
      <joint_name>slide_east</joint_name>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system"
      name="gz::sim::systems::JointController">
      <joint_name>slide_north</joint_name>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
    </plugin>

  </model>
</sdf>
