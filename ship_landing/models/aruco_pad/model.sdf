<?xml version="1.0"?>
<sdf version="1.9">
  <!-- 1.25 m square pad. The texture is 80% marker, so the marker is 1.0 m across.
       Regenerate the texture with tools/make_marker.py. -->
  <model name="aruco_pad">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry>
          <box>
            <size>1.25 1.25 0.02</size>
          </box>
        </geometry>
      </collision>
      <!-- Body of the pad, plain white. -->
      <visual name="base">
        <geometry>
          <box>
            <size>1.25 1.25 0.02</size>
          </box>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>
        </material>
      </visual>
      <!-- Marker face, a textured plane just above the top of the box. -->
      <visual name="marker">
        <pose>0 0 0.011 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>1.25 1.25</size>
          </plane>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>
          <pbr>
            <metal>
              <albedo_map>materials/textures/aruco_pad.png</albedo_map>
              <metalness>0.0</metalness>
              <roughness>1.0</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
