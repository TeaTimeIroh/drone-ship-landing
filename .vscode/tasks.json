{
    // Run these from VS Code: Terminal > Run Task..., or Ctrl+Shift+P > "Tasks: Run Task".
    // Ctrl+Shift+B runs the build task.
    "version": "2.0.0",
    "options": {
        "shell": { "executable": "/bin/bash", "args": ["-c"] }
    },
    "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
    "problemMatcher": [],
    "tasks": [
        {
            "label": "Sim: start (pad world + detector)",
            "type": "shell",
            "command": "if pgrep -f '[g]z sim' >/dev/null; then echo 'A simulator is already running. Run the task \"Sim: stop everything\" first.'; exit 1; fi; source '${workspaceFolder}/env.sh' && cd \"$ARDU_WS\" && ros2 launch ship_landing pad_sim.launch.py",
            "isBackground": true
        },
        {
            "label": "Sim: start with camera view",
            "type": "shell",
            "command": "if pgrep -f '[g]z sim' >/dev/null; then echo 'A simulator is already running. Run the task \"Sim: stop everything\" first.'; exit 1; fi; source '${workspaceFolder}/env.sh' && cd \"$ARDU_WS\" && ros2 launch ship_landing pad_sim.launch.py view:=true",
            "isBackground": true
        },
        {
            "label": "Sim: start moving pad (pad world + detector + pad motion)",
            "type": "shell",
            "command": "if pgrep -f '[g]z sim' >/dev/null; then echo 'A simulator is already running. Run the task \"Sim: stop everything\" first.'; exit 1; fi; source '${workspaceFolder}/env.sh' && cd \"$ARDU_WS\" && ros2 launch ship_landing pad_sim.launch.py world:=moving_pad view:=true pattern:=${input:padPattern}",
            "isBackground": true
        },
        {
            "label": "Sim: stop everything",
            "type": "shell",
            "command": "bash '${workspaceFolder}/ship_landing/tools/stop_sim.sh'"
        },
        {
            "label": "Fly: land on pad",
            "type": "shell",
            "command": "source '${workspaceFolder}/env.sh' && ros2 run ship_landing land_on_pad --ros-args -p use_sim_time:=true"
        },
        {
            "label": "Fly: takeoff demo",
            "type": "shell",
            "command": "source '${workspaceFolder}/env.sh' && ros2 run ship_landing takeoff_demo --ros-args -p use_sim_time:=true"
        },
        {
            "label": "Fly: hover and watch (60 s at 5 m, then land where it took off)",
            "type": "shell",
            "command": "source '${workspaceFolder}/env.sh' && ros2 run ship_landing takeoff_demo --ros-args -p use_sim_time:=true -p cruise_speed:=0.0 -p cruise_time:=60.0"
        },
        {
            "label": "Pad: set speed",
            "type": "shell",
            "command": "source '${workspaceFolder}/env.sh' && ros2 param set /pad_mover speed ${input:padSpeed}"
        },
        {
            "label": "Measure: quick check (1 batch of 2 landings, simulator already running)",
            "type": "shell",
            "command": "source '${workspaceFolder}/env.sh' && ros2 run ship_landing landing_trials --ros-args -p use_sim_time:=true -p trials:=2 -p output:='${workspaceFolder}/results/quick_check.csv'"
        },
        {
            "label": "Measure: full run (3 batches of 10 landings, starts its own simulator)",
            "type": "shell",
            "command": "'${workspaceFolder}/ship_landing/tools/run_trials.sh' 3 10"
        },
        {
            "label": "Measure: tilt check (static pad world must be running)",
            "type": "shell",
            "command": "source '${workspaceFolder}/env.sh' && OUT='${workspaceFolder}/results/tilt_check_'$(date +%Y%m%d_%H%M%S) && ros2 run ship_landing tilt_check --ros-args -p use_sim_time:=true -p output:=\"$OUT\"; python3 '${workspaceFolder}/ship_landing/tools/analyze_tilt.py' \"$OUT\""
        },
        {
            "label": "Check: where is the drone",
            "type": "shell",
            "command": "source '${workspaceFolder}/env.sh' && gz model -m iris -p 2>/dev/null | tail -n 3 && echo 'pad centre is at x = 3, y = 2'"
        },
        {
            "label": "Build package",
            "type": "shell",
            "command": "source '${workspaceFolder}/env.sh' && cd \"$ARDU_WS\" && colcon build --packages-select ship_landing --symlink-install",
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "Run tests",
            "type": "shell",
            "command": "cd '${workspaceFolder}/ship_landing' && python3 -m pytest test/test_pad_detection.py test/test_landing_control.py test/test_ground_truth.py test/test_trial_stats.py test/test_pad_motion.py test/test_levelling.py",
            "group": { "kind": "test", "isDefault": true }
        }
    ],
    "inputs": [
        {
            "id": "padPattern",
            "type": "pickString",
            "description": "Path of the moving pad",
            "options": ["line", "circle"],
            "default": "line"
        },
        {
            "id": "padSpeed",
            "type": "promptString",
            "description": "Pad speed in m/s, 0 to 3 (0 stops the pad; use a decimal point, e.g. 1.0)",
            "default": "0.5"
        }
    ]
}
